{
    "name": "vestige",
    "displayName": "Vestige — Change Risk from Git History",
    "description": "Know what you're about to break. Reads your local git history to show which files change together, who actually knows the code you're editing, and what decisions already constrain it.",
    "version": "1.1.0",
    "publisher": "codecharlan",
    "repository": {
        "type": "git",
        "url": "https://github.com/codecharlan/vestige-v1"
    },
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "SCM Providers",
        "Visualization",
        "Other"
    ],
    "keywords": [
        "git",
        "co-change",
        "coupling",
        "code ownership",
        "code review",
        "legacy code",
        "onboarding",
        "git history",
        "codeowners",
        "technical debt"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vestige.analyze",
                "title": "Vestige: Analyze Current File"
            },
            {
                "command": "vestige.showTimeline",
                "title": "Vestige: Show File Timeline"
            },
            {
                "command": "vestige.toggle",
                "title": "Vestige: Toggle Annotations"
            },
            {
                "command": "vestige.clearCache",
                "title": "Vestige: Clear Cache"
            },
            {
                "command": "vestige.showEvolution",
                "title": "Vestige: Show Code Evolution"
            },
            {
                "command": "vestige.showGraveyard",
                "title": "Vestige: Show Code Graveyard"
            },
            {
                "command": "vestige.showDashboard",
                "title": "Vestige: Show Team Dashboard"
            },
            {
                "command": "vestige.showAchievements",
                "title": "Vestige: Show Achievements"
            },
            {
                "command": "vestige.showDebt",
                "title": "Vestige: Show Technical Debt 📉"
            },
            {
                "command": "vestige.showBugs",
                "title": "Vestige: Show Bug Analysis 🐛"
            },
            {
                "command": "vestige.showZombies",
                "title": "Vestige: Show Zombie Code 🧟"
            },
            {
                "command": "vestige.rewind",
                "title": "Vestige: Rewind Workspace ⏪"
            },
            {
                "command": "vestige.stopRewind",
                "title": "Vestige: Stop Rewind ⏩"
            },
            {
                "command": "vestige.showPerformance",
                "title": "Vestige: Show Performance Timeline ⚡"
            },
            {
                "command": "vestige.showFlow",
                "title": "Vestige: Show Code Flow 🌊"
            },
            {
                "command": "vestige.checkDrift",
                "title": "Vestige: Check Documentation Drift 📚"
            },
            {
                "command": "vestige.checkHotPotato",
                "title": "Vestige: Check Hot Potato Files 🔥"
            },
            {
                "command": "vestige.showLore",
                "title": "Vestige: Show Lore Decisions 📜"
            },
            {
                "command": "vestige.aiHistorian",
                "title": "Vestige: AI Code Historian 💬"
            },
            {
                "command": "vestige.commandPalette",
                "title": "Vestige: Command Palette ⌨️"
            },
            {
                "command": "vestige.addDecision",
                "title": "Vestige: Add Lore Decision ➕"
            },
            {
                "command": "vestige.promoteLore",
                "title": "Vestige: Promote to Lore 📜"
            },
            {
                "command": "vestige.chatWithGhost",
                "title": "Vestige: Chat with Ghost Developer 👻"
            },
            {
                "command": "vestige.explainCommit",
                "title": "Vestige: AI Explain Commit 🤖"
            },
            {
                "command": "vestige.openFileAtCommit",
                "title": "Vestige: Open File at Commit 🕰️"
            },
            {
                "command": "vestige.viewDeletedFile",
                "title": "Vestige: View Deleted File 💀"
            },
            {
                "command": "vestige.resurrectFile",
                "title": "Vestige: Resurrect Deleted File ♻️"
            },
            {
                "command": "vestige.runTimeMachine",
                "title": "Vestige: Run Time Machine 🌀"
            },
            {
                "command": "vestige.showGravityWell",
                "title": "Vestige: Show Gravity Well 🌌"
            },
            {
                "command": "vestige.replayGhost",
                "title": "Vestige: Replay Ghost Cursor 👻"
            },
            {
                "command": "vestige.showPulse",
                "title": "Vestige: Show Architectural Pulse 💓"
            },
            {
                "command": "vestige.openWormhole",
                "title": "Vestige: Open Temporal Wormhole 🕳️"
            },
            {
                "command": "vestige.showSkillTree",
                "title": "Vestige: Show Skill Tree 🌳"
            },
            {
                "command": "vestige.askArchaeologist",
                "title": "Vestige: Ask AI Archaeologist 🔍"
            },
            {
                "command": "vestige.getRefactorIdeas",
                "title": "Vestige: Get Refactor Ideas 💡"
            },
            {
                "command": "vestige.shareLore",
                "title": "Vestige: Share Lore to Webhook 📤"
            },
            {
                "command": "vestige.openTimeTravel",
                "title": "Vestige: Open Time Travel Scrubbing ⏪"
            },
            {
                "command": "vestige.askHistorian",
                "title": "Vestige: Ask the Living Code Historian 💬"
            },
            {
                "command": "vestige.showArchitectureMap",
                "title": "Vestige: Show Architecture Map 🔭"
            },
            {
                "command": "vestige.toggleEcho",
                "title": "Vestige: Toggle Echo Chamber 🎵"
            },
            {
                "command": "vestige.showPetDetails",
                "title": "Vestige: Show Cipher Pet 🐣"
            },
            {
                "command": "vestige.setOpenAIKey",
                "title": "Vestige: Set OpenAI API Key 🔐"
            },
            {
                "command": "vestige.showHandoffRisks",
                "title": "Vestige: Show Knowledge Handoff Risks 🤝"
            },
            {
                "command": "vestige.findExperts",
                "title": "Vestige: Find Experts for This File 👤"
            },
            {
                "command": "vestige.resurrectWithGhost",
                "title": "Vestige: Resurrect Selection with Ghost 💀"
            },
            {
                "command": "vestige.lineHistory",
                "title": "Vestige: History of Selected Lines 🧬"
            },
            {
                "command": "vestige.auditCodeowners",
                "title": "Vestige: Audit CODEOWNERS Against History 🧾"
            },
            {
                "command": "vestige.showCoupledFiles",
                "title": "Vestige: Files That Change With This One 🔗"
            }
        ],
        "keybindings": [
            {
                "command": "vestige.askHistorian",
                "key": "ctrl+shift+h",
                "mac": "cmd+shift+h",
                "when": "editorTextFocus"
            },
            {
                "command": "vestige.lineHistory",
                "key": "ctrl+shift+l",
                "mac": "cmd+shift+l",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "vestige.lineHistory",
                    "when": "editorTextFocus",
                    "group": "vestige@1"
                },
                {
                    "command": "vestige.showTimeline",
                    "when": "editorTextFocus",
                    "group": "vestige@2"
                },
                {
                    "command": "vestige.findExperts",
                    "when": "editorTextFocus",
                    "group": "vestige@3"
                }
            ],
            "view/title": [
                {
                    "command": "vestige.showGraveyard",
                    "when": "view == vestige.graveyard",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "vestige.resurrectFile",
                    "when": "view == vestige.graveyard && viewItem == deletedFile"
                },
                {
                    "command": "vestige.viewDeletedFile",
                    "when": "view == vestige.graveyard && viewItem == deletedFile"
                }
            ]
        },
        "configuration": {
            "title": "Vestige",
            "properties": {
                "vestige.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Vestige temporal annotations"
                },
                "vestige.churnThreshold": {
                    "type": "number",
                    "default": 10,
                    "description": "Number of changes to mark as high churn (🔥)"
                },
                "vestige.fossilThreshold": {
                    "type": "number",
                    "default": 365,
                    "description": "Days since last change to mark as fossil (🗿)"
                },
                "vestige.showInlineAnnotations": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show inline temporal annotations"
                },
                "vestige.openaiApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "OpenAI API key for AI commit explanations (optional)"
                },
                "vestige.zombieAgeDays": {
                    "type": "number",
                    "default": 365,
                    "description": "Days of inactivity to mark code as Zombie (🧟)"
                },
                "vestige.driftDays": {
                    "type": "number",
                    "default": 30,
                    "description": "Days of drift between code and docs to trigger alert (📚)"
                },
                "vestige.hotPotatoAuthors": {
                    "type": "number",
                    "default": 5,
                    "description": "Number of distinct authors to mark as Hot Potato (🔥)"
                },
                "vestige.collabWebhookUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Slack/Discord webhook URL for sharing Lore insights"
                },
                "vestige.enableCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Temporal CodeLens annotations above functions and classes"
                },
                "vestige.coupledFileSuggestions": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "After you save a file, suggest the files that git history shows usually change alongside it. Shows at most three, once per file per session, with the number of shared commits as evidence."
                },
                "vestige.coupledFileThreshold": {
                    "type": "number",
                    "default": 50,
                    "minimum": 10,
                    "maximum": 100,
                    "markdownDescription": "Minimum co-change rate (percent of this file's recent commits that also touched the other file) before a file is suggested. Higher values mean fewer, more confident suggestions."
                },
                "vestige.codeLensMode": {
                    "type": "string",
                    "default": "risk-only",
                    "enum": [
                        "off",
                        "risk-only",
                        "detailed"
                    ],
                    "enumDescriptions": [
                        "No CodeLens annotations.",
                        "One annotation per function, and only where history indicates a real signal: a recorded decision, a churn hotspot, long stagnation, or concentrated ownership.",
                        "Author and age above every function, plus all risk signals and quick actions."
                    ],
                    "markdownDescription": "How much CodeLens detail to show. `risk-only` keeps the editor quiet and only annotates code where the history actually matters."
                }
            }
        },
        "views": {
            "explorer": [
                {
                    "id": "vestige.graveyard",
                    "name": "💀 Code Graveyard",
                    "icon": "images/ghost.svg"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src test",
        "pretest": "npm run lint && npm run compile",
        "test": "npm run test:unit && npm run test:integration:git",
        "pretest:unit": "npm run compile",
        "test:unit": "mocha --ui tdd --require ./test/setup.js test/unit/*.test.js",
        "test:integration": "node ./test/runTest.js",
        "test:integration:git": "mocha --ui tdd --require ./test/setup-integration.js test/integration/*.test.js",
        "pretest:integration:git": "npm run compile"
    },
    "dependencies": {
        "simple-git": "^3.19.1"
    },
    "devDependencies": {
        "@types/node": "^20.19.41",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vscode/test-electron": "^2.3.4",
        "eslint": "^8.47.0",
        "glob": "^10.3.3",
        "mocha": "^12.0.0",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3"
    }
}
