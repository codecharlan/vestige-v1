{
    "root": true,
    "env": {
        "node": true,
        "es2022": true
    },
    "parserOptions": {
        "ecmaVersion": 2022
    },
    "ignorePatterns": [
        "dist/",
        "node_modules/",
        "gradle-7.6/",
        "intellij/"
    ],
    "rules": {
        "no-unused-vars": [
            "warn",
            {
                "args": "none"
            }
        ],
        "no-console": "off",
        "semi": [
            "error",
            "always"
        ]
    },
    "overrides": [
        {
            "files": [
                "*.ts"
            ],
            "parser": "@typescript-eslint/parser",
            "plugins": [
                "@typescript-eslint"
            ],
            "rules": {
                "no-unused-vars": "off",
                "@typescript-eslint/no-unused-vars": [
                    "warn",
                    {
                        "args": "none",
                        "varsIgnorePattern": "^_"
                    }
                ]
            }
        }
    ]
}